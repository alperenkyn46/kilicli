{
  "name": "@kilic/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./in-memory": {
      "types": "./src/in-memory.ts",
      "default": "./src/in-memory.ts"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "default": "./src/seed.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed-main.ts"
  },
  "dependencies": {
    "@kilic/domain": "workspace:*",
    "@kilic/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
