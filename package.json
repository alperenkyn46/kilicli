{
  "name": "kilic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kilic/db generate",
    "db:migrate": "pnpm --filter @kilic/db migrate",
    "db:seed": "pnpm --filter @kilic/db seed"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "^10.11.0",
    "turbo": "^2.5.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1",
    "vitest": "catalog:"
  }
}
